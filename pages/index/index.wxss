.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 28rpx 64rpx;
    background: #f2f4f7;
}

/* ---------------- 顶部概览 ---------------- */
.hero {
    position: relative;
    box-sizing: border-box;
    padding: 36rpx 36rpx 30rpx;
    border-radius: 32rpx;
    background: linear-gradient(152deg, #121a2b 0%, #1d2839 52%, #26344a 100%);
    box-shadow: 0 16rpx 40rpx rgba(18, 26, 43, 0.24);
    overflow: hidden;
}

.hero-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hero-kicker {
    color: rgba(255, 255, 255, 0.56);
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 2rpx;
}

.hero-right {
    display: flex;
    align-items: center;
}

.hero-date {
    padding: 6rpx 16rpx;
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.78);
    font-size: 22rpx;
}

/* 刷新按钮 */
.refresh {
    display: flex;
    width: 72rpx;
    height: 72rpx;
    margin-left: 14rpx;
    align-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    justify-content: center;
}

.refresh-hover {
    background: rgba(255, 255, 255, 0.24);
}

.refresh-icon {
    color: #ffffff;
    font-size: 34rpx;
    line-height: 1;
}

.refresh.on .refresh-icon {
    animation: spin 0.9s linear infinite;
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

.metric {
    display: flex;
    align-items: flex-end;
    margin-top: 26rpx;
}

.metric-symbol {
    margin-bottom: 12rpx;
    color: #7ee2b0;
    font-size: 38rpx;
    font-weight: 600;
}

.metric-num {
    margin-left: 6rpx;
    color: #ffffff;
    font-size: 88rpx;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -2rpx;
}

.metric-cap {
    display: block;
    margin-top: 10rpx;
    color: rgba(255, 255, 255, 0.5);
    font-size: 24rpx;
}

.metric-note {
    display: block;
    margin-top: 6rpx;
    color: rgba(255, 255, 255, 0.34);
    font-size: 22rpx;
}

/* 纳指100 前一日行情 */
.idx {
    display: flex;
    align-items: center;
    margin-top: 22rpx;
    padding: 16rpx 20rpx;
    border-radius: 16rpx;
    background: rgba(255, 255, 255, 0.06);
    justify-content: space-between;
}

.idx-l {
    display: flex;
    align-items: baseline;
}

.idx-name {
    color: rgba(255, 255, 255, 0.82);
    font-size: 24rpx;
    font-weight: 500;
}

.idx-date {
    margin-left: 12rpx;
    color: rgba(255, 255, 255, 0.32);
    font-size: 20rpx;
}

.idx-r {
    display: flex;
    align-items: baseline;
}

.idx-point {
    color: rgba(255, 255, 255, 0.9);
    font-size: 26rpx;
    font-weight: 600;
}

.idx-pct {
    margin-left: 12rpx;
    font-size: 24rpx;
    font-weight: 600;
}

.idx.up .idx-pct {
    color: #ff7b72;
}

.idx.down .idx-pct {
    color: #4ade80;
}

.idx.flat .idx-pct {
    color: rgba(255, 255, 255, 0.6);
}

.hero-stats {
    display: flex;
    align-items: center;
    margin-top: 30rpx;
    padding-top: 24rpx;
    border-top: 2rpx solid rgba(255, 255, 255, 0.08);
}

.hs {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
}

.hs-line {
    width: 2rpx;
    height: 40rpx;
    margin: 0 20rpx;
    background: rgba(255, 255, 255, 0.1);
}

.hs-num {
    color: #ffffff;
    font-size: 32rpx;
    font-weight: 600;
}

.hs-cap {
    margin-top: 6rpx;
    color: rgba(255, 255, 255, 0.42);
    font-size: 20rpx;
}

/* 成立以来走势：月线、对数刻度，作为卡片底部的氛围带，不与上方数字争视觉 */
.trend {
    margin-top: 26rpx;
}

.trend-img {
    display: block;
    width: 100%;
    opacity: 0.85;
}

.trend-foot {
    display: flex;
    align-items: center;
    margin-top: 2rpx;
    justify-content: space-between;
}

.trend-year {
    color: rgba(255, 255, 255, 0.3);
    font-size: 19rpx;
    letter-spacing: 1rpx;
}

.trend-desc {
    color: rgba(255, 255, 255, 0.24);
    font-size: 19rpx;
}

.hero-foot {
    display: block;
    margin-top: 22rpx;
    color: rgba(255, 255, 255, 0.38);
    font-size: 21rpx;
}

/* ---------------- 过期提示 ---------------- */
.stale {
    display: flex;
    align-items: flex-start;
    margin-top: 20rpx;
    padding: 20rpx 24rpx;
    border-radius: 20rpx;
    background: #fff7ed;
    border: 2rpx solid #fed7aa;
}

.stale-dot {
    width: 12rpx;
    height: 12rpx;
    margin-top: 12rpx;
    border-radius: 50%;
    background: #f59e0b;
    flex-shrink: 0;
}

.stale-text {
    margin-left: 14rpx;
    color: #9a3412;
    font-size: 23rpx;
    line-height: 1.55;
}

/* ---------------- 渠道切换 ---------------- */
.channels {
    display: flex;
    margin-top: 22rpx;
}

.ch {
    display: flex;
    flex: 1;
    box-sizing: border-box;
    padding: 22rpx 24rpx;
    border-radius: 24rpx;
    background: #ffffff;
    flex-direction: column;
    border: 2rpx solid transparent;
}

.ch:first-child {
    margin-right: 16rpx;
}

.ch.on {
    background: #0f172a;
    border-color: #0f172a;
    box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.18);
}

.ch-name {
    color: #0f172a;
    font-size: 28rpx;
    font-weight: 600;
}

.ch-num {
    margin-top: 6rpx;
    color: #94a3b8;
    font-size: 21rpx;
}

.ch.on .ch-name {
    color: #ffffff;
}

.ch.on .ch-num {
    color: rgba(255, 255, 255, 0.55);
}

/* ---------------- 工具条 ---------------- */
.toolbar {
    display: flex;
    align-items: center;
    margin: 20rpx 0 18rpx;
    justify-content: space-between;
}

.seg {
    display: flex;
    padding: 5rpx;
    border-radius: 999rpx;
    background: #e6eaf0;
}

.seg-item {
    padding: 12rpx 30rpx;
    border-radius: 999rpx;
    color: #64748b;
    font-size: 24rpx;
    font-weight: 500;
}

.seg-item.on {
    background: #ffffff;
    color: #0f172a;
    font-weight: 600;
    box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.toggle {
    padding: 12rpx 24rpx;
    border-radius: 999rpx;
    background: #ffffff;
    color: #64748b;
    font-size: 23rpx;
    border: 2rpx solid #e6eaf0;
}

.toggle.on {
    border-color: #0f172a;
    background: #0f172a;
    color: #ffffff;
}

/* ---------------- 列表 ---------------- */
.list {
    display: flex;
    flex-direction: column;
}

.row {
    position: relative;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    margin-bottom: 16rpx;
    padding: 26rpx 28rpx 26rpx 34rpx;
    border-radius: 24rpx;
    background: #ffffff;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
}

.row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 8rpx;
    background: #cbd5e1;
}

.row.good::before {
    background: #16a34a;
}

.row.mid::before {
    background: #2563eb;
}

.row.low::before {
    background: #f59e0b;
}

.row.muted::before {
    background: #cbd5e1;
}

.row-hover {
    background: #f8fafc;
}

.row-body {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
}

.row-line {
    display: flex;
    align-items: center;
}

.row-title {
    max-width: 380rpx;
    color: #0f172a;
    font-size: 29rpx;
    font-weight: 600;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.share {
    margin-left: 10rpx;
    padding: 2rpx 12rpx;
    border-radius: 8rpx;
    background: #eef2f7;
    color: #64748b;
    font-size: 19rpx;
    font-weight: 600;
    flex-shrink: 0;
}

.row-sub-line {
    display: flex;
    align-items: center;
    margin-top: 10rpx;
}

.row-sub {
    color: #94a3b8;
    font-size: 22rpx;
}

.diff {
    margin-left: 12rpx;
    padding: 2rpx 12rpx;
    border-radius: 8rpx;
    background: #fff7ed;
    color: #b45309;
    font-size: 19rpx;
    flex-shrink: 0;
}

.row-value {
    display: flex;
    align-items: flex-end;
    margin-left: 20rpx;
    flex-direction: column;
    flex-shrink: 0;
}

.val-line {
    display: flex;
    align-items: baseline;
}

.val-sym {
    margin-right: 2rpx;
    font-size: 24rpx;
    font-weight: 600;
}

.val {
    color: inherit;
    font-size: 40rpx;
    font-weight: 700;
    line-height: 1.1;
}

.row.good .val-line {
    color: #16a34a;
}

.row.mid .val-line {
    color: #1d4ed8;
}

.row.low .val-line {
    color: #b45309;
}

.row.muted .val-line {
    color: #94a3b8;
}

.row.muted .val {
    font-size: 30rpx;
}

.val-cap {
    margin-top: 8rpx;
    color: #b6c0cf;
    font-size: 20rpx;
}

.list-end {
    padding: 20rpx 0 8rpx;
    color: #a8b3c4;
    font-size: 21rpx;
    text-align: center;
}

/* ---------------- 状态视图 ---------------- */
.state {
    display: flex;
    min-height: 420rpx;
    align-items: center;
    padding: 40rpx;
    border-radius: 28rpx;
    background: #ffffff;
    flex-direction: column;
    justify-content: center;
    text-align: center;
}

.state-icon {
    color: #cbd5e1;
    font-size: 52rpx;
    font-weight: 700;
}

.state-icon.danger {
    color: #ef4444;
}

.state-title {
    margin-top: 16rpx;
    color: #0f172a;
    font-size: 30rpx;
    font-weight: 600;
}

.state-desc {
    margin-top: 12rpx;
    color: #94a3b8;
    font-size: 24rpx;
    line-height: 1.6;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    margin-bottom: 20rpx;
    border: 6rpx solid #e2e8f0;
    border-top-color: #0f172a;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

.btn {
    margin-top: 28rpx;
    padding: 0 48rpx;
    border-radius: 999rpx;
    background: #0f172a;
    color: #ffffff;
    font-size: 26rpx;
    line-height: 76rpx;
}

.btn.ghost {
    background: #eef2f7;
    color: #475569;
}
